{
  "name": "obliq-2",
  "version": "3.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns='/__tests__/integration/'",
    "test:integration": "jest __tests__/integration --runInBand",
    "test:integration:api": "jest __tests__/integration/api --runInBand",
    "test:integration:mcp": "jest __tests__/integration/mcp --runInBand",
    "mcp-server:dev": "cd mcp-server && npm run dev",
    "mcp-server:build": "cd mcp-server && npm run build",
    "mcp-server:start": "cd mcp-server && npm start",
    "test:codegen": "jest __tests__/integration/code-generation --runInBand",
    "test:codegen:arduino": "TEST_ARDUINO_COMPILE=true jest __tests__/integration/code-generation",
    "test:codegen:watch": "jest --watch __tests__/integration/code-generation",
    "test:wasm": "jest __tests__/wasm --runInBand",
    "test:wasm:setup": "jest __tests__/wasm/emscripten-setup.test.ts",
    "test:wasm:model": "jest __tests__/wasm/model-compilation.test.ts",
    "test:wasm:cache": "jest __tests__/wasm/cache __tests__/storage",
    "wasm:build-docker": "docker build -t obliq-emscripten:latest -f __tests__/wasm/docker/Dockerfile.emscripten __tests__/wasm/docker",
    "as205:compare": "tsx scripts/compare-as205.ts",
    "as205:compare-final": "tsx scripts/compare-final-json.ts",
    "obliq:cgen": "tsx scripts/obliq-cgen.ts",
    "obliq:test": "tsx scripts/obliq-test.ts",
    "obliq:regen-saturnib-plant": "bash scripts/regen-saturnib-obliq-plant.sh",
    "mdl:ir": "npm --prefix ../mdl2obliq run mdl:ir --",
    "mdl:emit": "npm --prefix ../mdl2obliq run mdl:emit --",
    "eom:mdl-vs-rhs": "tsx scripts/eom-mdl-vs-rhs.ts",
    "ic:dual-path": "tsx scripts/ic-dual-path-compare.ts",
    "onpad:dual-path": "tsx scripts/onpad-dual-path-compare.ts",
    "test:mdl2obliq": "npm --prefix ../mdl2obliq test",
    "migrate:supabase": "tsx scripts/migrate-from-supabase.ts",
    "obliq:link": "tsx scripts/obliq-link.ts"
  },
  "dependencies": {
    "@mantine/core": "^8.1.3",
    "@mantine/hooks": "^8.1.3",
    "@mantine/notifications": "^8.1.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tabler/icons-react": "^3.34.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.5.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.11",
    "lucide-react": "^0.511.0",
    "mdl2obliq": "file:../mdl2obliq",
    "next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uplot": "^1.6.32",
    "zod": "^3.25.28",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@supabase/supabase-js": "^2.49.8",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-fetch": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "undici": "^7.16.0"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "jest": "$jest",
    "@types/jest": "$@types/jest",
    "katex": "$katex",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
