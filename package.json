{
  "name": "obliq-2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "mcp-server:dev": "cd mcp-server && npm run dev",
    "mcp-server:build": "cd mcp-server && npm run build",
    "mcp-server:start": "cd mcp-server && npm start",
    "test:codegen": "jest __tests__/integration/code-generation --runInBand",
    "test:codegen:arduino": "TEST_ARDUINO_COMPILE=true jest __tests__/integration/code-generation",
    "test:codegen:watch": "jest --watch __tests__/integration/code-generation",
    "test:wasm": "jest __tests__/wasm --runInBand",
    "test:wasm:setup": "jest __tests__/wasm/emscripten-setup.test.ts",
    "test:wasm:model": "jest __tests__/wasm/model-compilation.test.ts",
    "test:wasm:cache": "jest __tests__/wasm/cache/cacheKey.test.ts",
    "test:wasm:cache:integration": "jest __tests__/wasm/cache/SupabaseCacheManager.integration.test.ts",
    "wasm:build-docker": "docker build -t obliq-emscripten:latest -f __tests__/wasm/docker/Dockerfile.emscripten __tests__/wasm/docker"
  },
  "dependencies": {
    "@mantine/core": "^8.1.3",
    "@mantine/hooks": "^8.1.3",
    "@mantine/notifications": "^8.1.3",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "@tabler/icons-react": "^3.34.0",
    "dotenv": "^16.5.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.511.0",
    "next": "^15.5.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.15.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^3.25.28",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.14",
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supabase": "^2.58.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
