# Copy to .env.local and fill in values from your Supabase project.
#   cp .env.local.example .env.local
#
# Self-hosted Docker (manual install under e.g. ~/src/supabase-project):
#   NEXT_PUBLIC_SUPABASE_URL  = SUPABASE_PUBLIC_URL from that project's .env
#                               (default http://localhost:8000) — NOT a postgres:// URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = ANON_KEY (or SUPABASE_PUBLISHABLE_KEY if present)
#   SUPABASE_SERVICE_ROLE_KEY     = SERVICE_ROLE_KEY (or SUPABASE_SECRET_KEY if present)
#
# Supabase CLI (`npx supabase start`):
#   URL is usually http://127.0.0.1:54321
#   Keys are printed by `npx supabase status`

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-jwt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-jwt

# --- API tokens (server-side; generate long random strings) ---
# Used by /api/automations and legacy single-token Model Builder access
AUTOMATION_API_TOKEN=generate-a-long-random-string
MODEL_BUILDER_API_TOKEN=generate-another-long-random-string

# --- Optional MCP server ---
# MCP_SERVER_PORT=3001
# MCP_API_TOKEN=
# MCP_API_BASE_URL=http://localhost:3000
