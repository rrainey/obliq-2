# Copy to .env.local if you need to override defaults.
#   cp .env.local.example .env.local
#
# Obliq stores everything locally, per OS user:
#   ~/.config/obliq-2/obliq.db            SQLite index (models, versions, API tokens, WASM cache metadata)
#   ~/.config/obliq-2/models/<id>/        model.json, versions/, autosave.json
#   ~/.config/obliq-2/cache/wasm/         compiled WASM modules
# No database server or account is required.

# --- Storage location (optional) ---
# OBLIQ_HOME=/path/to/obliq-data        # default: ${XDG_CONFIG_HOME:-~/.config}/obliq-2

# --- Network (optional) ---
# The dev/start scripts bind to 127.0.0.1 and requests with a non-loopback Host are refused.
# OBLIQ_ALLOWED_HOSTS=my-workstation.lan

# --- API tokens (optional) ---
# MCP, automations, and scripts authenticate with tokens created on the /tokens page.
# AUTO_DELETE_EXPIRED_TOKENS=true

# --- Integration tests (optional) ---
# TEST_API_TOKEN=<token from /tokens>

# --- Optional MCP server ---
# MCP_SERVER_PORT=3001
# MCP_API_TOKEN=<token from /tokens>
# MCP_API_BASE_URL=http://localhost:3000

# --- One-time migration from Supabase (scripts/migrate-from-supabase.ts) ---
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
