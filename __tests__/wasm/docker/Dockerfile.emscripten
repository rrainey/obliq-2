# Dockerfile for Emscripten compilation environment
# Used for compiling C code to WebAssembly
# Uses official Emscripten Docker image for reliability

FROM emscripten/emsdk:3.1.56

# Install Node.js 20 for test execution
# (Emscripten image already has Node 16, but we want Node 20 for consistency)
RUN apt-get update && apt-get install -y \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Verify installations
RUN emcc --version && \
    node --version && \
    npm --version

# Create working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
